{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tracker",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "tracker.app:app"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "tracker-dev",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "tracker.app:app",
        "--reload",
        "--port",
        "8001"
      ],
      "port": 8001,
      "autoPort": false
    }
  ]
}
